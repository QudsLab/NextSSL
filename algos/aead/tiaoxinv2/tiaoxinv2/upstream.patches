patch: unaligned-tiaoxin-tablebased-c-helpers
why: Static helper functions for the memcpy-based word accesses of the other unaligned-* patches of this file (no new symbols).
file: upstream/ref/tiaoxin-tablebased.c
count: 1
find: typedef unsigned int  col;
replace: typedef unsigned int  col; static __inline hw jb_ldhw(const void *p, size_t i) { hw v; memcpy(&v, (const unsigned char *)p + 8 * i, 8); return v; } static __inline void jb_sthw(void *p, size_t i, hw v) { memcpy((unsigned char *)p + 8 * i, &v, 8); } static __inline col jb_ldcol(const void *p, size_t i) { col v; memcpy(&v, (const unsigned char *)p + 4 * i, 4); return v; } static __inline void jb_stcol(void *p, size_t i, col v) { memcpy((unsigned char *)p + 4 * i, &v, 4); }
