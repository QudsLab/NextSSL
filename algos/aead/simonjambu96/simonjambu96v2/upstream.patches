find: static inline void jambu_initialization(
replace: static __inline uint64_t jb_ld48(const void *p, size_t i) { uint64_t v; v = 0; memcpy(&v, (const unsigned char *)p + 8 * i, 6); return v; } static __inline void jb_st48(void *p, size_t i, uint64_t v) { memcpy((unsigned char *)p + 8 * i, &v, 6); } static inline void jambu_initialization(
