patch: unaligned-simon-c-helpers
why: Static helper functions for the memcpy-based word accesses of the other unaligned-* patches of this file (no new symbols).
file: upstream/ref/Simon.c
count: 1
find: void SimonKeySetup64(
replace: static __inline unsigned int jb_ld32(const void *p, size_t i) { unsigned int v; { size_t j; for (j = 0; j < 4; j++) ((unsigned char *)&v)[j] = ((const unsigned char *)p)[4 * i + j]; } return v; } static __inline uint64_t jb_ld64(const void *p, size_t i) { uint64_t v; { size_t j; for (j = 0; j < 8; j++) ((unsigned char *)&v)[j] = ((const unsigned char *)p)[8 * i + j]; } return v; } static __inline uint64_t jb_ld48(const void *p, size_t i) { uint64_t v; v = 0; { size_t j; for (j = 0; j < 6; j++) ((unsigned char *)&v)[j] = ((const unsigned char *)p)[8 * i + j]; } return v; } void SimonKeySetup64(
