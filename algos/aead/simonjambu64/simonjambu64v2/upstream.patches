file: upstream/ref/encrypt_simon64.c
count: 1
find: static inline void jambu_initialization(
replace: static __inline unsigned int jb_ld32(const void *p, size_t i) { unsigned int v; memcpy(&v, (const unsigned char *)p + 4 * i, 4); return v; } static __inline void jb_st32(void *p, size_t i, unsigned int v) { memcpy((unsigned char *)p + 4 * i, &v, 4); } static inline void jambu_initialization(
